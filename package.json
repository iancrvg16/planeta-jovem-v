{
  "name": "site_pj",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/metadata.mjs",
    "lint": "oxlint",
    "preview": "node scripts/preview.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:integration": "node scripts/check-integration.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "processar:entregas": "python3 scripts/processar-entregas.py",
    "seo:assets": "python3 scripts/gerar-seo.py",
    "test:conteudo": "node --experimental-strip-types scripts/check-content.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:links": "node scripts/check-links.mjs",
    "typecheck": "tsc -b",
    "test:python": "python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:docs": "node scripts/check-docs.mjs",
    "check:github": "python3 scripts/check-github.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/outfit": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
